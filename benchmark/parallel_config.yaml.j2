{#
   TensorRT-LLM extra LLM API options template.
   Rendered by generate_config.py for each sweep point.
   Passed to trtllm-serve via --extra_llm_api_options.

   Required variables:
     tp, moe_tp, moe_ep, dp_attention, conc,
     kv_cache_fraction, moe_backend
#}
tensor_parallel_size: {{ tp }}
{%- if moe_ep > 1 %}
moe_tensor_parallel_size: {{ moe_tp }}
moe_expert_parallel_size: {{ moe_ep }}
{%- endif %}
{%- if dp_attention %}
enable_attention_dp: true
{%- endif %}
{%- if moe_ep > 1 %}
moe_config:
  backend: {{ moe_backend }}
{%- endif %}
enable_autotuner: false
kv_cache_config:
  free_gpu_memory_fraction: {{ kv_cache_fraction }}
