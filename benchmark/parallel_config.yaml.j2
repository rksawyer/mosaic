{#
   TensorRT-LLM parallelism configuration template.
   Rendered by generate_config.py for each sweep point.

   Required variables:
     tp, moe_tp, moe_ep, dp_attention, conc, isl, osl,
     max_model_len, max_num_tokens, kv_cache_fraction, moe_backend
#}
tensor_parallel_size: {{ tp }}
{% if moe_ep > 1 %}
moe_tensor_parallel_size: {{ moe_tp }}
moe_expert_parallel_size: {{ moe_ep }}
{% endif %}
{% if dp_attention %}
enable_attention_dp: true
{% else %}
enable_attention_dp: false
{% endif %}

moe_config:
  backend: {{ moe_backend }}

kv_cache_config:
  dtype: fp8
  free_gpu_memory_fraction: {{ kv_cache_fraction }}
  enable_block_reuse: false

cuda_graph_config:
  enable_padding: true
  max_batch_size: {{ conc }}
{% if conc >= 64 %}
  padding_enabled: true
{% endif %}

pytorch_backend_config:
  enable_overlap_scheduler: true
  enable_iter_perf_stats: true
